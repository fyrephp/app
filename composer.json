{
    "name": "fyre/app",
    "description": "Application skeleton for FyreFramework.",
    "keywords": [
        "fyre",
        "fyrephp",
        "php",
        "framework",
        "skeleton"
    ],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Elusive",
            "email": "elusivecodes@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "fyre/framework": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.91",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --ansi --verbose --dry-run --diff",
        "cs:fix": "php-cs-fixer fix --ansi --verbose --diff",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
